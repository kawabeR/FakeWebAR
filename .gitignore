# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Ll]ibrary/BuildPlayerData/**

# Autogenerated VS/Rider/MD/Idea project files
.vs/
.vsconfig
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
