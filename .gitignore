# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Temporary debug capture files
BuildLog_WebGL.txt
GameViewCapture.png

# Burst AOT build byproduct that leaks into project root
/Data/

# Local tooling configs (not part of the Unity project)
.claude/
.vscode/
